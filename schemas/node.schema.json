{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AimiliVPN-NV node",
  "type": "object",
  "required": ["id", "source", "protocol", "endpoint", "status", "observed_at"],
  "properties": {
    "id": {"type": "string", "minLength": 8, "maxLength": 128},
    "source": {"type": "string", "minLength": 1},
    "country": {"type": ["string", "null"]},
    "country_code": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
    "protocol": {"enum": ["openvpn", "sstp", "softether", "l2tp_ipsec"]},
    "transport": {"enum": ["tcp", "udp", "unknown"]},
    "endpoint": {"type": "object", "required": ["host", "port"], "properties": {"host": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}, "additionalProperties": false},
    "auth": {"type": "object", "additionalProperties": true},
    "profile": {"type": ["string", "null"], "description": "Optional public profile only; never put private credentials here."},
    "status": {"enum": ["pending", "checking", "preliminary_available", "verified_connected", "failed", "paused"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "last_checked_at": {"type": ["string", "null"]},
    "latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "egress_ip": {"type": ["string", "null"]},
    "failure_count": {"type": "integer", "minimum": 0},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
